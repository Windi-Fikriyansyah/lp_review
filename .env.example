# ===== Belibayar (isi sendiri, jangan di-commit) =====
# Base URL hanya domain, tanpa path dan tanpa "/" di akhir
BELIBAYAR_BASE_URL=https://api.belibayar.id
# "sandbox" untuk uji coba, "live" untuk transaksi sungguhan
BELIBAYAR_ENV=sandbox
# Dashboard Belibayar > Kredensial. Sandbox: byr_test_..., Live: byr_live_...
BELIBAYAR_API_KEY=
# secret_key pasangan dari API key di atas (sandbox dan live berbeda)
BELIBAYAR_SECRET_KEY=
# webhook_secret (BUKAN secret_key) untuk verifikasi X-Belibayar-Signature
BELIBAYAR_WEBHOOK_SECRET=

# ===== Aplikasi =====
# URL publik situs kamu, tanpa "/" di akhir. Dipakai untuk callback & redirect.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Harga dalam rupiah. Harga selalu dihitung di server, bukan dari browser.
PRODUCT_PRICE=149000

# ===== Database PostgreSQL =====
DATABASE_URL=postgresql://username:password@localhost:5432/database_name?sslmode=disable
# Set true jika penyedia database mewajibkan SSL (misal Neon / Supabase / Railway)
DATABASE_SSL=false

# ===== Webhook Create User =====
REACH_LEADS_SECRET_KEY=reach-leads-secret-key-123
CREATE_USER_API_URL=https://appreachlead.webkite.online/api/webhook/create-user
